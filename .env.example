# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of email addresses that should always resolve to
# super_admin regardless of what's in the profiles table. Rescue path: you
# cannot be locked out as long as you can edit env vars in Vercel.
SUPER_ADMIN_EMAILS=bennettbonta@gmail.com
# Mirror of SUPER_ADMIN_EMAILS for the client-side AuthProvider so the nav
# badge / role-aware UI doesn't have to round-trip the DB. Same value.
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=bennettbonta@gmail.com

# Transition-only escape hatch. When set to "true", the middleware AND the
# /admin server-side guard fall back to the pre-Supabase-Auth cookie check
# (`venue-owner-auth=authenticated`). Production should leave this UNSET.
# Local-only emergency fallback if the new auth misbehaves.
# LEGACY_AUTH_BYPASS=true
# NEXT_PUBLIC_LEGACY_AUTH_BYPASS=true

# Database
DATABASE_PASSWORD=your-database-password

# Resend Email API
RESEND_API_KEY=re_your_resend_api_key_here

# Where venue inquiries land when the venue's listed email is auto-generated
# (info@<slug>.com) and would otherwise bounce. Defaults to
# hello@floridaweddingwonders.com if unset.
LEAD_FALLBACK_EMAIL=hello@floridaweddingwonders.com

# Public phone number rendered in the footer / contact page. Leave unset to
# hide the phone row entirely (preferred over a placeholder).
# NEXT_PUBLIC_SITE_PHONE=(305) 555-0199

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Florida Wedding Wonders
NODE_ENV=development
ENVIRONMENT=development

# IndexNow API Configuration
# Get your key from: https://www.bing.com/indexnow
# Then create a verification file: /public/[your-key].txt containing the key
INDEXNOW_API_KEY=a1eccd8545f2408d99b27ab29c795911

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5WN9B7HLTH
